{
  "manifest_version": 3,
  "name": "JEV Browser",
  "version": "0.4.1",
  "description": "A browser agent with Jev + LLM planning and a local MCP bridge.",
  "minimum_chrome_version": "125",
  "permissions": [
    "tabs",
    "tabGroups",
    "scripting",
    "debugger",
    "sidePanel",
    "storage",
    "alarms",
    "webNavigation",
    "downloads"
  ],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open JEV Browser"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src http://127.0.0.1:* ws://127.0.0.1:*"
  }
}
